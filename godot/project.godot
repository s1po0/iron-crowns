; Iron Crowns — actual 3D Android vertical slice.
config_version=5

[application]
config/name="Iron Crowns: The Marches"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.4.0"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=4
limits/opengl/max_renderable_elements=4096
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.66, 0.78, 0.81, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=false
